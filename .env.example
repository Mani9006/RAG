# Copy to .env and fill in. Everything has a safe default — the platform runs
# end-to-end in simulation mode with no API key and zero spend.

# --- LLM backend -------------------------------------------------------------
# "simulation" = deterministic offline backend (free, used by CI and the demo)
# "anthropic"  = live Claude agents via the Anthropic API
SENTINEL_LLM_BACKEND=simulation

# Required only when SENTINEL_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Model used by all agents in live mode
SENTINEL_MODEL=claude-opus-4-8

# Hard ceiling on total tokens a single pipeline run may consume in live mode.
# The orchestrator aborts the run when the budget is exhausted.
SENTINEL_RUN_TOKEN_BUDGET=400000

# --- Governance --------------------------------------------------------------
# Procurement actions above this USD amount always require human approval,
# regardless of what the compliance agent decides.
SENTINEL_AUTO_APPROVE_LIMIT_USD=25000

# --- Notification fabric -------------------------------------------------------
# Slack-compatible incoming-webhook URL. Empty disables notifications.
SENTINEL_WEBHOOK_URL=
# Notify on incidents at or above this severity: critical | high | medium | low
SENTINEL_NOTIFY_MIN_SEVERITY=high

# --- Service -----------------------------------------------------------------
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_LOG_LEVEL=INFO
